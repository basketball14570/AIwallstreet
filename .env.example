# --- API keys (data providers) ---
UNUSUAL_WHALES_API_KEY=
POLYGON_API_KEY=

# --- Sentiment / social (optional) ---
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
NEWS_API_KEY=

# --- Datastores ---
DATABASE_URL=postgresql+asyncpg://flow:flow@localhost:5432/flow
REDIS_URL=redis://localhost:6379/0

# --- Alerts ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Flow source ---
# auto = Polygon when POLYGON_API_KEY is set, else synthetic.
# Options: auto | synthetic | polygon | unusual_whales
FLOW_PROVIDER=auto
# Tickers scanned for unusual options flow (Polygon provider).
WATCH_TICKERS=TSLA,NVDA,AAPL,AMD,PLTR,SOFI,GME,AMC,MARA,RIVN
POLYGON_FLOW_POLL_SEC=30
# Snapshot pages pulled per ticker per cycle (250 contracts/page). The endpoint
# can't sort by volume, so we page the chain and keep the most active contracts.
# Raise for fuller coverage on large chains (NVDA/TSLA); 1 = single page.
POLYGON_FLOW_MAX_PAGES=6
# Keep only the top-N contracts by day volume after paging.
POLYGON_FLOW_TOP_CONTRACTS=250
# Min day-volume / open-interest ratio for a contract to count as unusual.
# Lower = more flow (good while testing); raise to tighten.
FLOW_MIN_VOL_OI=0.35
# Min total premium ($) for a synthesised flow event.
FLOW_MIN_PREMIUM=10000

# --- Behaviour ---
# Minimum confidence (0-100) required before an alert is dispatched.
ALERT_MIN_CONFIDENCE=70
# Only these classifications fire alerts (comma-separated; blank = any).
ALERT_CLASSIFICATIONS=Potential Explosion Setup,Strong Momentum Setup
# Only alert on out-of-the-money calls; puts may alert at any moneyness.
ALERT_CALLS_OTM_ONLY=true
# Screener alert gates (all off by default — set to tighten what fires):
# Require day-volume > open interest (a freshly opened position).
ALERT_REQUIRE_OPENING=false
# Reject alerts whose IV-rank exceeds this (don't chase rich vol). 1.0 = off;
# IV-rank 0.5 means "unknown".
ALERT_MAX_IV_RANK=1.0
# For multi-leg flow, only alert bullish structures (call vertical / risk
# reversal); skip neutral/hedge structures.
ALERT_BULLISH_STRUCTURES_ONLY=false
# "Unusual Options Activity" alerts — fire on raw screener signals (vol/OI,
# premium, opening, near-dated) regardless of the conviction score. This is the
# path that works WITHOUT option quotes/trades (e.g. Polygon Options Starter),
# where bought-vs-sold direction can't be computed. Tune to taste:
ALERT_ON_UNUSUAL_ACTIVITY=true
ALERT_UNUSUAL_VOL_OI=5.0
ALERT_UNUSUAL_PREMIUM=500000
ALERT_UNUSUAL_DTE_MAX=60
# Anti-spam: on startup the scanner sees the whole day's volume at once. The
# grace window lets that backlog fill the dashboard WITHOUT alerting (only new
# activity after start alerts). The cooldown stops one contract re-alerting.
ALERT_STARTUP_GRACE_SEC=120
ALERT_COOLDOWN_MIN=360
# Watchlist price alerts: how often (seconds) to poll your watchlist tickers and
# ping when one crosses its breakout/breakdown level.
WATCHLIST_POLL_SEC=300
# Heads-up when price comes within this % of a watched level before it crosses.
WATCHLIST_APPROACH_PCT=0.5
# Trade-idea journal. PUBLIC_BASE_URL is the address your phone can reach the app
# at — used for the clickable "Add to journal" link in alerts. Set it to your LAN
# IP (e.g. http://192.168.1.50:8000) or a tunnel URL so the link works off-machine.
PUBLIC_BASE_URL=http://localhost:8000
JOURNAL_INTRADAY_HOURS=3
JOURNAL_POLL_SEC=600
# Optional: free Finnhub key (finnhub.io) adds a "reports in N days" earnings
# warning to cards. Leave blank and no earnings line is shown (never faked).
FINNHUB_API_KEY=

# --- AI analyst (Anthropic) ---
# When set, the dashboard's "AI analyst take" button and the nightly proactive
# scanner use Claude to reason over flow + technicals + your levels. Costs a few
# cents per analysis. Leave blank to disable both.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-7
LLM_EFFORT=high
# Proactive nightly scan is OFF by default. The key alone only powers the
# on-demand "AI take" button and "My Options" analysis. Set this true later to
# get the daily auto-push of top setups.
AI_SCAN_ENABLED=false
AI_SCAN_TOP_N=3

# ---- Technical breakout screener -------------------------------------------
# The self-driven side: sweep this universe and rank the stocks coiling for an
# expansion ("about to explode") from price/volume technicals — no options flow
# required. The /screener endpoint always works; the nightly auto-push is off by
# default. SCREENER_SCAN_ENABLED=true turns on the daily shortlist to Telegram/
# Discord. 🔥 candidates are confluence: a coil that ALSO has unusual call flow.
SCREENER_UNIVERSE=TSLA,NVDA,AAPL,AMD,PLTR,SOFI,GME,AMC,MARA,RIVN,META,AMZN,GOOGL,MSFT,NFLX,COIN,SMCI,AVGO,MU,INTC,BABA,UBER,SHOP,SQ,ROKU,DKNG,CCL,F,NIO,LCID,AFRM,HOOD,SNAP,PINS,DDOG,NET,CRWD,PANW,ARM,DELL
SCREENER_MIN_SCORE=70
SCREENER_TOP_N=5
SCREENER_SCAN_ENABLED=false
SCREENER_FLOW_LOOKBACK_HOURS=48

ENV=dev
LOG_LEVEL=INFO
